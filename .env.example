# Copiar a .env para desarrollo local. En Cloud Run estos valores vienen de Secret Manager.
GCP_PROJECT_ID=
GCP_REGION=us-east1

# Twilio (número de la demo y envío de SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Secreto compartido con el que ElevenLabs se autentica contra la API
AGENT_TOOLS_SECRET=

# Demo: número que recibe TODOS los SMS (formato +57...) y "hoy" congelado
DEMO_SMS_TO=
DEMO_NOW=2026-10-13T10:00:00-05:00

# Almacenamiento: memoria (local) o firestore (Cloud Run)
STORAGE=memoria
FIRESTORE_DB=aeroandes
PUBLIC_BASE_URL=http://localhost:8080
