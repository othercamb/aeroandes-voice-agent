# Copiar a .env para desarrollo local. En Cloud Run estos valores vienen de Secret Manager.
GCP_PROJECT_ID=
GCP_REGION=us-east1

# Twilio (número de la demo y envío de SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Secreto compartido con el que ElevenLabs se autentica contra la API
AGENT_TOOLS_SECRET=
